{
  "name": "jeero-mcp",
  "version": "1.0.2",
  "description": "Local Jeero MCP server backed by Mother and SQLite.",
  "type": "module",
  "bin": {
    "jeero-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "start": "node ./dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "jeero",
    "sqlite"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimndap/jeero-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/slimndap/jeero-mcp/issues"
  },
  "homepage": "https://github.com/slimndap/jeero-mcp#readme",
  "mcpName": "io.github.slimndap/jeero-mcp",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^12.4.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
